# Igra × Tangem Giveaway (/tangem-claim)
# Copy to `.env` (or `.env.local`) and fill in real values. Do NOT commit real values.

# Base URL of the Igra giveaway backend (no trailing slash needed). Public,
# unauthenticated (no API key). Recommended host follows existing Igra services
# (apis.igralabs.com/<service>): https://apis.igralabs.com/giveaway
# Frontend calls: POST {URL}/eligibility and POST {URL}/verify — see
# src/pages/TangemClaimPage/API.md for the full contract.
VITE_GIVEAWAY_API_URL=

# WalletConnect (Reown) Cloud project id — free at https://cloud.reown.com.
# Required for wallet connection (Tangem connects via WalletConnect QR / deep-link).
# Without it, the claim page shows a "wallet connection not configured" message.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional (dev only): set to 1 to mock ONLY the email OTP endpoints
# (/email/start, /email/confirm) — eligibility + verify still call the real API,
# so VITE_GIVEAWAY_API_URL is still required. Mock code is always 123456.
# Leave unset in production.
VITE_GIVEAWAY_MOCK=

# Sentry error reporting (optional). The DSN is a public client-side key — safe to
# commit/embed. Error reporting is off when unset and on localhost. Set it per
# Netlify context (production + deploy-preview) to catch prod/preview crashes.
VITE_SENTRY_DSN=
# Optional Sentry release id (e.g. commit SHA) for grouping errors by deploy.
VITE_SENTRY_RELEASE=

# PoolStakes (/igra-vesting) network profile: mainnet (default) | galleon | fork.
VITE_POOLSTAKES_NETWORK=
